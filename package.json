{
  "name": "internet-mindmap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @internet-mindmap/api --filter @internet-mindmap/web --filter @internet-mindmap/extension --parallel dev",
    "dev:api": "pnpm --filter @internet-mindmap/api dev",
    "dev:web": "pnpm --filter @internet-mindmap/web dev",
    "dev:ext": "pnpm --filter @internet-mindmap/extension dev",
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter @internet-mindmap/extension build",
    "typecheck": "pnpm -r typecheck",
    "deploy:api": "pnpm --filter @internet-mindmap/api deploy",
    "db:generate": "pnpm --filter @internet-mindmap/api db:generate",
    "db:migrate": "pnpm --filter @internet-mindmap/api db:migrate",
    "db:studio": "pnpm --filter @internet-mindmap/api db:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
