# ── Auth tokens (set as Worker secrets with `wrangler secret put`) ──
EXTENSION_API_TOKEN=ext-your-token-here
AGENT_API_TOKEN=agent-your-token-here

# ── Web SPA (packages/web/.env) ──
# VITE_API_URL=https://internet-mindmap-api.<account>.workers.dev
# VITE_API_TOKEN=ext-your-token-here

# ── CF Bindings (configured in wrangler.toml, not env vars) ──
# DB          → D1 database
# VECTORIZE   → Vectorize index (768d, cosine)
# AI          → Workers AI binding
# PROCESS_ITEM → Workflow binding

# ── Optional: AI Provider Overrides ──
# Default: Workers AI (EmbeddingGemma + Kimi K2.5) via CF bindings — no env vars needed
# These are only needed if you want to use external providers:

# Gemini (for embeddings)
# GOOGLE_AI_API_KEY=...

# OpenAI (for embeddings)
# OPENAI_API_KEY=sk-...

# Anthropic (for LLM)
# ANTHROPIC_API_KEY=sk-ant-...
