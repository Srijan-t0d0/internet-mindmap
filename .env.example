# ============================================================================
# Internet Mindmap — Environment Variables
# ============================================================================
# Copy this file and fill in values for each package that needs configuration.
# Each section indicates WHERE the .env file should live.
#
# Quick start (local dev):
#   1. Set Worker secrets (see "API Worker Secrets" below)
#   2. Create apps/web/.env with API_WORKER_URL
#   3. Create packages/extension/.env with WXT_API_BASE
#   4. Run: pnpm dev:api && pnpm dev:web && pnpm dev:ext
# ============================================================================


# ── API Worker Secrets (set via `wrangler secret put <NAME>`) ────────────────
# These are NOT in a .env file — they're stored as encrypted Worker secrets.

# Google OAuth (required for auth)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Better Auth session signing key (any random string, 32+ chars)
# BETTER_AUTH_SECRET=generate-a-random-secret-here

# Legacy bearer token for external AI agents
# AGENT_API_TOKEN=agent-your-token-here


# ── API Worker Vars (packages/api/wrangler.toml [vars]) ─────────────────────
# These are already set in wrangler.toml with local dev defaults.
# Override in wrangler.toml or via `wrangler secret put` for production.

# BETTER_AUTH_URL=http://localhost:3030      # Web app origin (NOT Worker URL)
# APP_BASE_URL=http://localhost:3030         # Web app URL for redirects


# ── API Worker: Vector Provider (optional) ──────────────────────────────────
# Default: "d1" (local SQLite-based, no setup needed)
# Options: "d1" | "vectorize" | "upstash"

# VECTOR_PROVIDER=d1

# Required only if VECTOR_PROVIDER=upstash (set via wrangler secret put):
# UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
# UPSTASH_VECTOR_REST_TOKEN=your-upstash-read-write-token


# ── Web App (apps/web/.env) ─────────────────────────────────────────────────

# Worker URL the Next.js proxy routes requests to
# API_WORKER_URL=http://localhost:8787

# Optional: dev-only auth token (skips Cloudflare Access in local dev)
# NEXT_PUBLIC_API_TOKEN=dev-local-token


# ── Browser Extension (packages/extension/.env) ────────────────────────────

# API base URL the extension talks to
# WXT_API_BASE=http://localhost:8787

# Google OAuth client ID (for extension OAuth flow)
# WXT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# ── CF Bindings (configured in wrangler.toml, NOT env vars) ─────────────────
# These are Cloudflare resource bindings, not environment variables.
# DB            → D1 database
# VECTORIZE     → Vectorize index (768d, cosine)
# AI            → Workers AI binding
# PROCESS_ITEM  → Workflow binding
