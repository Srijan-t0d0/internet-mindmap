{
  "name": "@internet-mindmap/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply internet-mindmap --local",
    "db:migrate:remote": "wrangler d1 migrations apply internet-mindmap --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@internet-mindmap/shared": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@upstash/vector": "^1.2.3",
    "ai": "^6.0.141",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "uuid": "^11.1.0",
    "vectra": "^0.12.3",
    "workers-ai-provider": "^3.1.8",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0",
    "wrangler": "^4.14.0"
  }
}
